  {
    "description": "an OO-LD schema document carries a root @context",
    "rule": "OOLD-SCH-96a3",
    "schemas": [
      {
        "description": "a schema document without a root @context is rejected",
        "valid": false,
        "schema": {
          "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
          "$id": "https://oo-ld.test/compliance/vocab-no-context.schema.json",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          }
        }
      },
      {
        "description": "a root @context may be an IRI reference to a remote context",
        "valid": true,
        "schema": {
          "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
          "$id": "https://oo-ld.test/compliance/vocab-remote-context.schema.json",
          "@context": "https://oo-ld.test/compliance/remote.context.json",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          }
        }
      },
      {
        "description": "an empty root @context satisfies the requirement",
        "valid": true,
        "schema": {
          "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
          "$id": "https://oo-ld.test/compliance/vocab-empty-context.schema.json",
          "@context": {},
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          }
        }
      },
      {
        "description": "a root @context may be an array combining a remote reference and local terms",
        "valid": true,
        "schema": {
          "$schema": "https://oo-ld.org/latest/meta/oold-meta-schema.json",
          "$id": "https://oo-ld.test/compliance/vocab-array-context.schema.json",
          "@context": [
